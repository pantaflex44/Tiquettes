{
    "name": "tiquettes",
    "title": "Tiquettes",
    "description": "Générateur d'étiquettes pour tableaux et armoires électriques. Sublimer vos tableaux électriques tout en répondant aux besoins de la norme en vigueur. Fonctionnalités et esthétisme pour tous vos projets.",
    "version": "2.2.9",
    "keywords": [
        "étiquette",
        "schéma",
        "tableau",
        "armoire",
        "électrique",
        "électricité",
        "unifilaire",
        "créer",
        "générateur",
        "schneider",
        "hager",
        "legrand"
    ],
    "author": "Christophe LEMOINE",
    "license": "AGPL-3.0",
    "homepage": "https://www.tiquettes.fr/app/",
    "repository": {
        "type": "git",
        "url": "https://github.com/pantaflex44/Tiquettes"
    },
    "funding": [
        {
            "type": "individual",
            "url": "https://www.tiquettes.fr/dons.php"
        },
        {
            "type": "Ko-fi",
            "url": "https://ko-fi.com/pantaflex44"
        }
    ],
    "type": "module",
    "scripts": {
        "update:all": "npx npm-check-updates -u && npm install",
        "compile": "cross-env NODE_ENV=dev && concurrently \"node ./app-config-compiler.cjs\" \"node ./sitemap-generator.cjs\"",
        "copies": "concurrently \"cpx src/schema_functions.json public/api/libs/toPdf/assets\" \"cpx src/schema_sources.json public/api/libs/toPdf/assets\"",
        "predev": "concurrently \"npm run copies\"",
        "dev": "cross-env NODE_ENV=dev concurrently \"php -S localhost:8080 -t public/api\" \"vite\"",
        "prebuild": "concurrently \"npm run copies\"",
        "build": "cross-env NODE_ENV=ghpages vite build --mode ghpages",
        "prebuild:web": "concurrently \"npm run copies\"",
        "build:web": "cross-env NODE_ENV=web vite build --mode web",
        "prebuild:dev": "concurrently \"npm run copies\"",
        "build:dev": "cross-env NODE_ENV=dev vite build --mode dev",
        "lint": "biome check --write ./src",
        "preview": "vite preview --port 8080",
        "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/favicon.svg",
        "gitpush:dev": "func() { git checkout dev && npm run compile && git add . && git commit -m \"$1\" && git push origin dev; }; func",
        "gitmerge:main": "func() { git checkout main && git merge dev -m \"Merge branch dev\" && git push origin main && git checkout dev; }; func"
    },
    "dependencies": {
        "@vite-pwa/assets-generator": "^1.0.2",
        "axios": "^1.19.0",
        "compare-versions": "^6.1.1",
        "convert-source-map": "^2.0.0",
        "cpx": "^1.5.0",
        "cpx2": "^9.0.0",
        "glob": "^13.0.6",
        "process": "^0.11.10",
        "react": "^19.2.8",
        "react-color": "^2.19.3",
        "react-dom": "^19.2.8",
        "sanitize-filename": "^1.6.4",
        "semver": "^7.8.5",
        "sharp": "^0.35.3",
        "urix": "^0.1.0",
        "use-debounce": "^10.1.1",
        "vite-plugin-pwa": "^1.3.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.1.0",
        "concurrently": "^10.0.5",
        "cross-env": "^10.1.0",
        "react-error-overlay": "^6.1.0",
        "vite": "^8.2.2",
        "vite-plugin-biome": "^1.2.0",
        "vite-plugin-mkcert": "^2.1.0",
        "vite-plugin-open-graph": "^2.0.6"
    },
    "allowScripts": {
        "sharp@0.33.5": true,
        "sharp@0.34.5": true,
        "core-js@2.6.12": true
    }
}